# 本地开发环境变量（wrangler dev 读取）
# 复制为 `.dev.vars`（gitignored）并填写真实值：cp backend/.env .dev.vars 后删除 DATABASE_URL / PORT 行
# 生产环境不要用本文件，改用 `wrangler secret put <NAME>`（见 backend/docs/deployment.md）
# 生产环境不要设置 TURNSTILE_DEV_SECRET_KEY

JWT_SECRET=
AUTH_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DEV_SECRET_KEY=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET_NAME=
WEATHER_API_KEY=
# 高德 Web 服务 key：只给 /api/city/amap 代理用（管理端出图时注入），浏览器拿不到
AMAP_KEY=
# Cloudflare API token：只给 /api/cache/* 用（管理端清缓存）。需要 Zone:Read + Cache Purge，
# 见 backend/docs/cache-purge.md；不设它只有清缓存那条链路报 500
CF_API_TOKEN=
