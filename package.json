{
  "type": "module",
  "scripts": {
    "dev": "bun scripts/gen-icons.ts && PORTLESS_TLD=localhost portless run nuxt dev",
    "dev:plain": "bun scripts/gen-icons.ts && nuxt dev",
    "gen:icons": "bun scripts/gen-icons.ts",
    "generate": "bun scripts/gen-icons.ts && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "index": "pagefind --site dist --output-path .cache/pagefind && rm -rf dist/pagefind && cp -R .cache/pagefind dist/pagefind",
    "build": "pnpm run generate && pnpm run index",
    "sort-i18n": "bun scripts/sort-i18n.ts",
    "fmt": "pnpm run sort-i18n && oxfmt",
    "api:install": "pnpm --dir backend install",
    "api:dev": "PORTLESS_TLD=localhost portless run --name kuriyona-api --app-port 62802 wrangler dev --port 62802",
    "api:run": "wrangler dev --port 62802",
    "api:orm-generate": "pnpm --dir backend run orm-generate",
    "api:d1:migrate:local": "wrangler d1 migrations apply kuriyona-db --local",
    "api:d1:migrate:remote": "wrangler d1 migrations apply kuriyona-db --remote",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@iconify/vue": "^5.0.3",
    "@kuriyona/amap-box": "^0.4.0",
    "@kuriyona/yona-svg": "^0.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "8.6.1",
    "@pagefind/component-ui": "^1.5.2",
    "@pinia/nuxt": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/markdown-exit": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "github-markdown-css": "^5.9.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "ky": "^2.2.0",
    "markdown-exit": "^1.3.0",
    "nuxt": "^4.6.1",
    "pinia": "^4.0.3",
    "qrcode.vue": "^3.11.0",
    "reading-time": "^1.5.0",
    "reka-ui": "^2.11.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "vue-turnstile": "^1.0.11"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/simple-icons": "^1.2.100",
    "@types/node": "^26.6.5",
    "fflate": "^0.8.3",
    "oxfmt": "^0.72.0",
    "pagefind": "^1.5.2",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.4.0",
  "portless": "kuriyona"
}
